          ],
          "block_id": 5,
          "block_order": 4
        },
        {
          "block_label": "text",
          "block_content": "3. Interactive Java demos (audio is now included for eigenvalues).",
          "block_bbox": [
            521,
            1493,
            2440,
            1560
          ],
          "block_id": 6,
          "block_order": 5
        },
        {
          "block_label": "text",
          "block_content": "4. Linear Algebra Teaching Codes and MATLAB problems.",
          "block_bbox": [
            520,
