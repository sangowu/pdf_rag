          "block_order": 14
        },
        {
          "block_label": "formula",
          "block_content": "A=\\begin{bmatrix}1&1&2\\\\ 1&2&3\\\\ 1&3&4\\end{bmatrix}\\qquad\\mathbf{d o e s}\\;n o t\\;\\mathbf{h a v e}\\;\\mathbf{i n d e p e n d e n t}\\;\\mathbf{c o l u m n s}.",
          "block_bbox": [
