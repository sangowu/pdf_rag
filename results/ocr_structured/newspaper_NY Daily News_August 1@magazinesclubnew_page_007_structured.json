              2790.0
            ]
          ]
        },
        {
          "block_label": "doc_title",
          "block_content": "Suspect stunned to see video of himself torching woman: documents",
          "block_bbox": [
            236,
            2834,
            3643,
            3009
          ],
          "block_id": 5,
          "block_order": 2,
          "group_id": 5,
          "block_polygon_points": [
            [
              236.0,
              2834.0
            ],
            [
              3643.0,
              2834.0
            ],
            [
              3643.0,
              3009.0
            ],
            [
              236.0,
              3009.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Sebastian Zapeta, the migrant accused of fatally setting homeless woman Debrina Kawam on fire on a Coney Island subway train, pleaded not guilty Tuesday – even as court papers revealed he said, \"Oh, damn, that's me,\" when shown the horrific video of the attack that shocked the city.",
          "block_bbox": [
            240,
            3213,
            1058,
            3584
          ],
          "block_id": 6,
          "block_order": 3,
          "group_id": 6,
          "block_polygon_points": [
            [
              240.0,
              3213.0
            ],
            [
              1058.0,
              3213.0
            ],
            [
              1058.0,
              3584.0
            ],
            [
              240.0,
              3584.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Zapeta, a 33-year-old Guatemalan migrant living in a Brooklyn men’s shelter, was arraigned before Brooklyn Supreme Court Justice Danny Chun on first-degree murder and arson charges. Chun ordered he remain held without bail until his next court appearance March 12.",
          "block_bbox": [
            240,
            3586,
            1059,
            3954
          ],
          "block_id": 7,
          "block_order": 4,
          "group_id": 7,
          "block_polygon_points": [
            [
              240.0,
              3586.0
            ],
            [
              1059.0,
              3586.0
            ],
            [
              1059.0,
              3954.0
            ],
            [
              240.0,
              3954.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Until recently, 57-year-old Kawam was listed as a “Jane Doe” on the indictment against Zapeta. Authorities identified her last week and Assistant District Attorney Matthew Perry on Tuesday had the document amended to include her name.",
          "block_bbox": [
            240,
            3957,
            1060,
            4272
          ],
          "block_id": 8,
          "block_order": 5,
          "group_id": 8,
          "block_polygon_points": [
            [
              240.0,
              3957.0
            ],
            [
              1060.0,
              3957.0
            ],
            [
              1060.0,
              4272.0
            ],
            [
              240.0,
              4272.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "After Zapeta’s arrest, he told a trio of NYPD detectives – one of whom translated from Spanish – that he had no memory of what he’d done and that he often drank so much he would “erase the memory” of what happened and wake up at home.",
          "block_bbox": [
            239,
            4274,
            1061,
            4588
          ],
          "block_id": 9,
          "block_order": 6,
          "group_id": 9,
          "block_polygon_points": [
            [
              239.0,
              4274.0
            ],
            [
              1061.0,
              4274.0
            ],
            [
              1061.0,
              4588.0
            ],
            [
              239.0,
              4588.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "The detectives confronted him with the video, with one telling him, “The best thing for us here, we want to know why you went to that woman in front of you and set fire to her. Why did you do it?”",
          "block_bbox": [
            238,
            4590,
            1060,
            4753
          ],
          "block_id": 10,
          "block_order": 7,
          "group_id": 10,
          "block_polygon_points": [
            [
              238.0,
              4590.0
            ],
            [
              1060.0,
              4590.0
            ],
            [
              1060.0,
              4753.0
            ],
            [
              238.0,
              4753.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "",
          "block_bbox": [
            1103,
            3055,
            1924,
            3160
          ],
          "block_id": 11,
          "block_order": 8,
          "group_id": 10,
          "block_polygon_points": [
            [
              1103.0,
              3055.0
            ],
            [
              1924.0,
              3055.0
            ],
            [
              1924.0,
              3160.0
            ],
            [
              1103.0,
              3160.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "“To tell you the truth, to be honest, I don’t remember,” Zapeta replied.",
          "block_bbox": [
            1108,
            3165,
            1924,
            3270
          ],
          "block_id": 12,
          "block_order": 9,
          "group_id": 12,
          "block_polygon_points": [
            [
              1108.0,
              3165.0
            ],
            [
              1924.0,
              3165.0
            ],
            [
              1924.0,
              3270.0
            ],
            [
              1108.0,
              3270.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "When the detectives showed Zapeta video of himself as he lit Kawam ablaze, he responded with surprise, according to court documents.",
          "block_bbox": [
            1104,
            3272,
            1924,
            3479
          ],
          "block_id": 13,
          "block_order": 10,
          "group_id": 13,
          "block_polygon_points": [
            [
              1104.0,
              3272.0
            ],
            [
              1924.0,
              3272.0
            ],
            [
              1924.0,
              3479.0
            ],
            [
              1104.0,
              3479.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "“Who is that person?” the Spanish-speaking detective asks, and Zapeta responds, “Oh, damn, that’s me.”",
          "block_bbox": [
            1106,
            3480,
            1925,
            3638
          ],
          "block_id": 14,
          "block_order": 11,
          "group_id": 14,
          "block_polygon_points": [
            [
              1106.0,
              3480.0
            ],
            [
              1925.0,
              3480.0
            ],
            [
              1925.0,
              3638.0
            ],
            [
              1106.0,
              3638.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "“That’s you, right?,” the cop continues, and Zapeta responds, “Yes.”",
          "block_bbox": [
            1105,
            3641,
            1924,
            3744
          ],
          "block_id": 15,
          "block_order": 12,
          "group_id": 15,
          "block_polygon_points": [
            [
              1105.0,
              3641.0
            ],
            [
              1924.0,
              3641.0
            ],
            [
              1924.0,
              3744.0
            ],
            [
              1105.0,
              3744.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "“Do you see what’s happening now? Do you see what you’re doing? You are setting that woman on fire. Do you remember that or not?” the detective asks.",
          "block_bbox": [
            1106,
            3747,
            1924,
            3953
          ],
          "block_id": 16,
          "block_order": 13,
          "group_id": 16,
          "block_polygon_points": [
            [
              1106.0,
              3747.0
            ],
            [
              1924.0,
              3747.0
            ],
            [
              1924.0,
              3953.0
            ],
            [
              1106.0,
              3953.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "“No, I really don’t remember,” Zapeta responds.",
          "block_bbox": [
            1107,
            3956,
            1924,
            4059
          ],
          "block_id": 17,
          "block_order": 14,
          "group_id": 17,
          "block_polygon_points": [
            [
              1107.0,
              3956.0
            ],
            [
              1924.0,
              3956.0
            ],
            [
              1924.0,
              4059.0
            ],
            [
              1107.0,
              4059.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "“But that’s you, right?” the detective asks.",
          "block_bbox": [
            1106,
            4061,
            1925,
            4164
          ],
          "block_id": 18,
          "block_order": 15,
          "group_id": 18,
          "block_polygon_points": [
            [
              1106.0,
              4061.0
            ],
            [
              1925.0,
              4061.0
            ],
            [
              1925.0,
              4164.0
            ],
            [
              1106.0,
              4164.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "“Yes,” Zapeta replies, according to the court documents.",
          "block_bbox": [
            1107,
            4169,
            1925,
            4272
          ],
          "block_id": 19,
          "block_order": 16,
          "group_id": 19,
          "block_polygon_points": [
            [
              1107.0,
              4169.0
            ],
            [
              1925.0,
              4169.0
            ],
            [
              1925.0,
              4272.0
            ],
            [
              1107.0,
              4272.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "When asked again why he did it, Zapeta responds, “I am very sorry. I didn’t mean to. But I really don’t know. I don’t know what happened, but I’m very sorry for that woman.”",
          "block_bbox": [
            1105,
            4273,
            1925,
            4533
          ],
          "block_id": 20,
          "block_order": 17,
          "group_id": 20,
          "block_polygon_points": [
            [
              1105.0,
              4273.0
            ],
            [
              1925.0,
              4273.0
            ],
            [
              1925.0,
              4533.0
            ],
            [
              1105.0,
              4533.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Zapeta approached Kawam as she slept in an F train stopped at the end of the line at Coney Island-Stillwell Ave. station at about 7:30 a.m. Dec. 22, according to cops. They appeared to be strangers, police said.",
          "block_bbox": [
            1104,
            4537,
            1928,
            4753
          ],
          "block_id": 21,
          "block_order": 18,
          "group_id": 21,
          "block_polygon_points": [
            [
              1104.0,
              4537.0
            ],
            [
              1928.0,
              4537.0
            ],
            [
              1928.0,
              4753.0
            ],
            [
              1104.0,
              4753.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "",
          "block_bbox": [
            1974,
            3056,
            2793,
            3163
          ],
          "block_id": 22,
          "block_order": 19,
          "group_id": 21,
          "block_polygon_points": [
            [
              1974.0,
              3056.0
            ],
            [
              2793.0,
              3056.0
            ],
            [
              2793.0,
              3163.0
            ],
            [
              1974.0,
              3163.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "He said nothing to her as he set her clothing ablaze with a lighter, then fanned the fire with a shirt as the flames engulfed her, according to prosecutors.",
          "block_bbox": [
            1972,
            3165,
            2793,
            3374
          ],
          "block_id": 23,
          "block_order": 20,
          "group_id": 23,
          "block_polygon_points": [
            [
              1972.0,
              3165.0
            ],
            [
              2793.0,
              3165.0
            ],
            [
              2793.0,
              3374.0
            ],
            [
              1972.0,
              3374.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Chilling video shows Zapeta sitting on a bench on the train platform as Kawam burned to death as she stood helplessly near the subway car’s open door.",
          "block_bbox": [
            1972,
            3376,
            2790,
            3587
          ],
          "block_id": 24,
          "block_order": 21,
          "group_id": 24,
          "block_polygon_points": [
            [
              1972.0,
              3376.0
            ],
            [
              2790.0,
              3376.0
            ],
            [
              2790.0,
              3587.0
            ],
            [
              1972.0,
              3587.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Surveillance video later recovered by cops shows Zapeta inside the subway car and a police officer’s body cam got a clear shot of his face, cops said. The NYPD quickly released images of the suspect to the media and a trio of high schoolers spotted him on another train later in the day and called 911, the commissioner said.",
          "block_bbox": [
            1971,
            3588,
            2792,
            4058
          ],
          "block_id": 25,
          "block_order": 22,
          "group_id": 25,
          "block_polygon_points": [
            [
              1971.0,
              3588.0
            ],
            [
              2792.0,
              3588.0
            ],
            [
              2792.0,
              4058.0
            ],
            [
              1971.0,
              4058.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Zapeta was arrested by Customs and Border Patrol in Arizona on June 2, 2018, sources said, then removed by Immigration and Customs Enforcement officials and returned to Guatemala. But he made his way back to the U.S. sometime after.",
          "block_bbox": [
            1972,
            4060,
            2794,
            4378
          ],
          "block_id": 26,
          "block_order": 23,
          "group_id": 26,
          "block_polygon_points": [
            [
              1972.0,
              4060.0
            ],
            [
              2794.0,
              4060.0
            ],
            [
              2794.0,
              4378.0
            ],
            [
              1972.0,
              4378.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Zapeta told the detectives he came back to the U.S. illegally about five years ago, arriving in Queens with his wife’s nephew. Relatives took him in but that living situation fell apart during the COVID-19 pandemic.",
          "block_bbox": [
            1971,
            4380,
            2794,
            4690
          ],
          "block_id": 27,
          "block_order": 24,
          "group_id": 27,
          "block_polygon_points": [
            [
              1971.0,
              4380.0
            ],
            [
              2794.0,
              4380.0
            ],
            [
              2794.0,
              4690.0
            ],
            [
              1971.0,
              4690.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "“I stayed with them, but in the pandemic, they threw me out because of my brother-in-law. Okay, after the pandemic I went out to work and my brother-in-law called them and told him that… my brother-in-law was working with us, and he said that all the guys that worked there were infected with coronavirus.”",
          "block_bbox": [
            2022,
            4694,
            2792,
            4750
          ],
          "block_id": 28,
          "block_order": 25,
          "group_id": 28,
          "block_polygon_points": [
            [
              2022.0,
              4694.0
            ],
            [
              2792.0,
              4694.0
            ],
            [
              2792.0,
              4750.0
            ],
            [
              2022.0,
              4750.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "",
          "block_bbox": [
            2838,
            3056,
            3659,
            3426
          ],
          "block_id": 29,
          "block_order": 26,
          "group_id": 28,
          "block_polygon_points": [
            [
              2838.0,
              3056.0
            ],
            [
              3659.0,
              3056.0
            ],
            [
              3659.0,
              3426.0
            ],
            [
              2838.0,
              3426.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Up until his arrest, he was doing construction work in Queens, meeting his employer, who he refers to as “the Mexican,” outside the boss’ house in Jamaica before a job.",
          "block_bbox": [
            2838,
            3429,
            3656,
            3689
          ],
          "block_id": 30,
          "block_order": 27,
          "group_id": 30,
          "block_polygon_points": [
            [
              2838.0,
              3429.0
            ],
            [
              3656.0,
              3429.0
            ],
            [
              3656.0,
              3689.0
            ],
            [
              2838.0,
              3689.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "He finished work the day before the attack about 5:30 p.m., then after his employer picked him up and drove him back to Queens, he went to a bar in Jamaica to buy beer and get drunk, he told detectives.",
          "block_bbox": [
            2838,
            3850,
            3657,
            4112
          ],
          "block_id": 31,
          "block_order": 28,
          "group_id": 31,
          "block_polygon_points": [
            [
              2838.0,
              3850.0
            ],
            [
              3657.0,
              3850.0
            ],
            [
              3657.0,
              4112.0
            ],
            [
              2838.0,
              4112.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "“He has a lot of work. He takes us to Brooklyn, or in Queens... or Wall Street,” he told the detectives.",
          "block_bbox": [
            2839,
            3693,
            3656,
            3846
          ],
          "block_id": 32,
          "block_order": 29,
          "group_id": 32,
          "block_polygon_points": [
            [
              2839.0,
              3693.0
            ],
            [
              3656.0,
              3693.0
            ],
            [
              3656.0,
              3846.0
            ],
            [
              2839.0,
              3846.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "He had to hand over his sweater and a bracelet and when the officers noted he was wearing two pairs of pants he explained, “I have two because of the cold weather.”",
          "block_bbox": [
            2837,
            4274,
            3657,
            4534
          ],
          "block_id": 33,
          "block_order": 30,
          "group_id": 33,
          "block_polygon_points": [
            [
              2837.0,
              4274.0
            ],
            [
              3657.0,
              4274.0
            ],
            [
              3657.0,
              4534.0
            ],
            [
              2837.0,
              4534.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Zapeta had $178.80 on him when police arrested him and told the cops processing him, “That’s all I have.”",
          "block_bbox": [
            2837,
            4115,
            3658,
            4270
          ],
          "block_id": 34,
          "block_order": 31,
          "group_id": 34,
          "block_polygon_points": [
            [
              2837.0,
              4115.0
            ],
            [
              3658.0,
              4115.0
            ],
            [
              3658.0,
