        {
          "block_label": "text",
          "block_content": "【路斯股份】：公司于 2022 年 5 月 23 日公布《股票解除限售公告》。公司本次股票解除限售数量总额为 151 万股，占公司总股本 1.46%，可交易时间为 2022 年 5 月 27 日。",
          "block_bbox": [
            631,
            1589,
            2313,
            1724
          ],
          "block_id": 7,
          "block_order": 3,
          "group_id": 7,
