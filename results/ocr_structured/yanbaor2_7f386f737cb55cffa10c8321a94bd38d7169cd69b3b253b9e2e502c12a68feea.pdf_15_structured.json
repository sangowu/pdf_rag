  {
    "filename": "yanbaor2_7f386f737cb55cffa10c8321a94bd38d7169cd69b3b253b9e2e502c12a68feea.pdf_15.pdf",
    "page_index": 15,
    "core_content": {
      "parsing_res_list": [
        {
          "block_label": "paragraph_title",
          "block_content": "技术投入的增加，将带来科技类财税优惠机会",
          "block_bbox": [
            258,
            131,
            2773,
            257
          ],
          "block_id": 0,
          "block_order": 1
        },
        {
          "block_label": "paragraph_title",
          "block_content": "转型“OMO模式“，线下连锁教培机构需在教务/教学系统、学员管理系统、监课系统等方面新增技术开发和软件相关投入，需擅用科技类财税优惠政策\n",
          "block_bbox": [
            204,
            500,
            3130,
            652
          ],
          "block_id": 1,
          "block_order": 2
        },
        {
          "block_label": "paragraph_title",
          "block_content": "外采第三方技术支持平台",
          "block_bbox": [
            318,
            765,
            1031,
            835
          ],
          "block_id": 2,
          "block_order": 3
        },
        {
          "block_label": "paragraph_title",
          "block_content": "开发自有技术支持平台",
          "block_bbox": [
            2301,
            771,
            2950,
            843
          ],
          "block_id": 3,
          "block_order": 4
        },
        {
          "block_label": "text",
          "block_content": "增加对软件和技术服务的采购",
          "block_bbox": [
            252,
            993,
            979,
            1051
          ],
          "block_id": 4,
          "block_order": 5
        },
        {
          "block_label": "text",
          "block_content": "采购端增加大量采购后，可能改变企业的增值税实际税负率",
          "block_bbox": [
            324,
            1095,
            1113,
            1208
          ],
          "block_id": 5,
          "block_order": 6
        },
        {
          "block_label": "text",
          "block_content": "需重新评估增值税计税方式：一般计税方式还是简易征收方式?",
          "block_bbox": [
            323,
            1257,
            1113,
            1371
          ],
          "block_id": 6,
          "block_order": 7
        },
        {
          "block_label": "text",
          "block_content": "外采平台的稳定性，以及对上课效果和服务质量的影响\n",
          "block_bbox": [
            254,
            1418,
            1111,
            1533
          ],
          "block_id": 7,
          "block_order": 8
        },
        {
          "block_label": "text",
          "block_content": "提高老师的在线授课技能",
          "block_bbox": [
            251,
            1581,
            877,
            1635
          ],
          "block_id": 8,
          "block_order": 9
        },
        {
          "block_label": "text",
          "block_content": "外采",
          "block_bbox": [
            1339,
            1174,
            1516,
            1266
          ],
          "block_id": 9,
          "block_order": 10
        },
        {
          "block_label": "text",
          "block_content": "线上化采取的不同技术投入方式，如何与现有的核心业务更好的结合？\n",
          "block_bbox": [
            1232,
            1550,
            1765,
            1825
          ],
          "block_id": 10,
          "block_order": 11
        },
        {
          "block_label": "text",
          "block_content": "自研",
          "block_bbox": [
            1786,
            1175,
            1951,
            1268
          ],
          "block_id": 11,
          "block_order": 12
        },
        {
          "block_label": "text",
          "block_content": "增设技术研发部（产品组、技术组、\n测试组等）\n\n擅用科技类相关的财税优惠政策，\n提高税务效率\n\n研发费用加计扣除（包括委托开\n发研发费用加计扣除）\n\n高新技术企业\n\n重视线上运营\n\n提高老师的在线授课技能\n\n",
          "block_bbox": [
            2200,
            988,
            3077,
            1755
          ],
          "block_id": 12,
          "block_order": 13
        },
        {
          "block_label": "header",
          "block_content": "技术投入的增加，将带来科技类财税优惠机会\n",
          "block_bbox": [
