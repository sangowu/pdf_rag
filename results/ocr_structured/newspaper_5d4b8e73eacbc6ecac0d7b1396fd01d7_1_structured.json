        {
          "block_label": "text",
          "block_content": "曹国刚上任后实行公开民主理财，完全由村理财小组管理，村“两委”班子主要负责协调事情，不经手一分钱，村集体收入的60%直接发给村民，40%用于集体，发展公益事业。",
          "block_bbox": [
            596,
            2355,
            1165,
            2651
          ],
          "block_id": 16,
          "block_order": 9,
          "group_id": 16,
