        {
          "block_label": "paragraph_title",
          "block_content": "“村里变化这么大,多亏了有个好支书”",
          "block_bbox": [
            16,
            2661,
            570,
            2789
          ],
          "block_id": 12,
          "block_order": 5,
          "group_id": 12,
          "block_polygon_points": [
