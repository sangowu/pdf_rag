        {
          "block_label": "paragraph_title",
          "block_content": "Explanation of the standard deviation calculation shown in the table",
          "block_bbox": [
            290,
            1627,
            1655,
            1679
          ],
          "block_id": 8,
          "block_order": 5,
          "group_id": 8,
          "block_polygon_points": [
            [
              290.0,
