            [
              125.0,
              1026.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "主要产品产销持续增长，海外天然气涨价增厚贸易利润。前三季度公司煤炭销量达到1918.79万吨，同比+36.64%；天然气销量416,316.16万方，同比+24.76%。三季度以来，在欧洲能源紧缺的背景下，海外天然气价格不断上涨，公司海外天然气贸易显著受益，预计未来几年全球天然气仍然处于紧平衡，因此公司LNG长协贸易套利值得期待。",
          "block_bbox": [
            126,
            1043,
            1510,
            1337
          ],
          "block_id": 7,
          "block_order": 5,
          "group_id": 7,
          "block_polygon_points": [
            [
              126.0,
              1043.0
            ],
            [
              1510.0,
              1043.0
