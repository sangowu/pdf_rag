        {
          "block_label": "text",
          "block_content": "Model We are asked to find the magnetic field due to a simple current distribution, so this example is a typical problem for which the Biot–Savart law is appropriate. We must find the field contribution from a small element of current and then integrate over the current distribution from  $ \\theta_{1} $ to  $ \\theta_{2} $, as shown in Figure 29.3b.",
          "block_bbox": [
            123,
            121,
            846,
            220
          ],
          "block_id": 3,
          "block_order": 1,
          "group_id": 3,
          "block_polygon_points": [
            [
              123.0,
              121.0
            ],
            [
              846.0,
              121.0
