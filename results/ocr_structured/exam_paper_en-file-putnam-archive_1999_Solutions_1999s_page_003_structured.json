          "block_content": " $$ f^{\\prime\\prime}f^{\\prime\\prime\\prime}(x)\\leq f^{\\prime\\prime}(x)f(x)<f^{\\prime\\prime}(x)f(x)+f^{\\prime}(x)^{2} $$ ",
          "block_bbox": [
