              2767.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "and if $z$ has negative real part, so does $1/(z-r_i)$ for $i=1,\\ldots,n$, so the sum is nonzero.",
          "block_bbox": [
