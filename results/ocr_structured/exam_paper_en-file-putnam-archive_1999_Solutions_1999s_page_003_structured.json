            ],
            [
              1326.0,
              2189.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "From the inequality  $ f'''(x) \\leq f(x) $ we obtain",
          "block_bbox": [
            1414,
            2197,
            2173,
            2249
          ],
          "block_id": 25,
          "block_order": 25,
          "group_id": 25,
          "block_polygon_points": [
