              1784.0,
              515.0
            ],
            [
              1784.0,
              717.0
            ],
            [
              278.0,
              717.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "早在18世纪，法国水手德·拉·博丹纳斯就曾用鲜艳的各色彩旗代表0～9十个数字，用不同的旗子组合表示不同的意思。这大概便是在航海上使用旗语的开始。大约在1800年，英国海军也开始使用旗语；1856年英国陆军军医发明了通过摇摆一面旗子便能表示不同意思的旗语。",
          "block_bbox": [
            280,
            740,
            1784,
            944
          ],
          "block_id": 4,
          "block_order": 3,
          "group_id": 4,
          "block_polygon_points": [
            [
              280.0,
              740.0
            ],
            [
              1784.0,
              740.0
            ],
            [
              1784.0,
              944.0
            ],
            [
              280.0,
              944.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "旗语简洁明了，基本上能表达水手们在海上航行时所要经常传递的一些信息。通过一本旗语手册，任何国籍的水手都能不受语言的影响而彼此沟通。由于这种方式的简便性和有效性，它至今仍为航海者所青睐，成为他们共同的“语言”。",
          "block_bbox": [
            279,
            966,
            1782,
            1168
          ],
          "block_id": 5,
          "block_order": 4,
          "group_id": 5,
          "block_polygon_points": [
            [
              279.0,
              966.0
            ],
            [
              1782.0,
              966.0
            ],
            [
              1782.0,
              1168.0
            ],
            [
              279.0,
              1168.0
            ]
          ]
        },
        {
          "block_label": "vision_footnote",
          "block_content": "灯塔指引\n着航海者的方向",
          "block_bbox": [
            135,
            1717,
            275,
            1856
          ],
          "block_id": 6,
          "block_order": null,
          "group_id": 6,
          "block_polygon_points": [
