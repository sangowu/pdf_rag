        {
          "block_label": "text",
          "block_content": "视觉通信直接作用于人的眼睛，具有直观、简洁的特点。除了前面章节提到的烽火通信和遥望通信之外，属于这类通信方式的还有古老的旗语、灯塔、红绿灯，以及近代的传真、电视、电视电话等。",
          "block_bbox": [
            278,
            515,
            1784,
            717
          ],
          "block_id": 3,
          "block_order": 2,
          "group_id": 3,
          "block_polygon_points": [
            [
              278.0,
              515.0
