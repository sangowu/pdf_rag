              315.0,
              2781.0
            ]
          ]
        },
        {
          "block_label": "display_formula",
          "block_content": " $$ \\begin{align*}\\int_{-1}^{1}\\left|P(x)\\right|dx&=\\int_{-1}^{1}\\left|Q(x)R(x)\\right|dx\\\\&>\\int_{-1}^{1}\\left|Q(x)(R(x)-kx)\\right|dx,\\end{align*} $$ ",
          "block_bbox": [
