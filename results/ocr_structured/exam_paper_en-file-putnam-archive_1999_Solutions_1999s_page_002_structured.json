            [
              319.0,
              1653.0
            ]
          ]
        },
        {
          "block_label": "display_formula",
          "block_content": " $$ \\frac{\\left|P(x)\\right|}{\\left|P(0)\\right|}=\\prod_{i=1}^{1999}\\frac{\\left|x-r_{i}\\right|}{\\left|r_{i}\\right|}. $$ ",
          "block_bbox": [
