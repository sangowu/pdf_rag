          ],
          "block_id": 3,
          "block_order": 4
        },
        {
          "block_label": "text",
          "block_content": "Consumers are switching to cheaper channels and more aggressively seeking discounts and promotions ",
          "block_bbox": [
            156,
            1772,
            989,
            1938
          ],
          "block_id": 4,
          "block_order": 5
        },
        {
          "block_label": "text",
          "block_content": "5Local companies are winning ",
          "block_bbox": [
            163,
            2141,
            893,
            2356
          ],
          "block_id": 5,
          "block_order": 6
        },
        {
          "block_label": "text",
          "block_content": "Consumers are choosing local brands for their quality and innovation and not just for cheaper prices, or out of a sense of national pride \n",
