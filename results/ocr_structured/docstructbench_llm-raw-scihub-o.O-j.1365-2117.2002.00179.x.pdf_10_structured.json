            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "The results of the analyses of the uncertainty of the field data and related assumptions are shown in Figs 13 and 14. Polygons  $ \\eta_{\\mathrm{P}} $,  $ \\eta_{\\mathrm{M}} $, and  $ \\eta_{\\mathrm{D}} $ in the x-y plane represent the spatial distribution of any possible  $ x_{\\mathrm{adv}} $, that was obtained from the data sets measured at sites P, M, and D, respectively. The degree of overlap between polygons is expressed as  $ \\rho_{\\mathrm{PM}} $ (for overlap between  $ \\eta_{\\mathrm{P}} $ and  $ \\eta_{\\mathrm{M}} $) and  $ \\rho_{\\mathrm{MD}} $ (for overlap between  $ \\eta_{\\mathrm{M}} $ and  $ \\eta_{\\mathrm{D}} $) (see Eq. (11)).",
          "block_bbox": [
            143,
            1452,
            609,
            1502
          ],
          "block_id": 6,
          "block_order": 4,
          "group_id": 6,
          "block_polygon_points": [
            [
              143.0,
              1452.0
            ],
            [
              609.0,
