          ],
          "block_id": 8,
          "block_order": 9
        },
        {
          "block_label": "text",
          "block_content": "如:Ican see five kites .--How many kites can you see?",
          "block_bbox": [
            376,
            2420,
            1733,
            2470
          ],
          "block_id": 9,
          "block_order": 10
        },
        {
          "block_label": "text",
          "block_content": "There is some milk in the glass.---How much milk is there in the glass?",
