        {
          "block_label": "vision_footnote",
          "block_content": "Vladislav Kreynin\nSenior Vice President and\nDirector of the Marketing\nand Communications\nDepartment,\nSber",
          "block_bbox": [
            166,
            1232,
            664,
            1557
          ],
