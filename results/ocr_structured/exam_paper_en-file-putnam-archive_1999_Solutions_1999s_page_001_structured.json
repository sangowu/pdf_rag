              321.0,
              1111.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "so we may set  $ f(x) = (3x + 3)/2 $,  $ g(x) = 5x/2 $, and  $ h(x) = -x + \\frac{1}{2} $.",
          "block_bbox": [
            316,
