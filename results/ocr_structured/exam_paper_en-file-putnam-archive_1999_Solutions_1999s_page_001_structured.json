        {
          "block_label": "display_formula",
          "block_content": " $$ \\begin{aligned}2b_{2n+1}+b_{2n}&=2a_{n}a_{n+1}+2a_{n-1}a_{n}+a_{n-1}^{2}+a_{n}^{2}\\\\&=2a_{n}a_{n+1}+a_{n-1}a_{n+1}+a_{n}^{2}\\\\&=a_{n+1}^{2}+a_{n}^{2}=b_{2n+2},\\end{aligned} $$ ",
          "block_bbox": [
