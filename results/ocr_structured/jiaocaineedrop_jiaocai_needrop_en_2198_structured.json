        {
          "block_label": "text",
          "block_content": "After training hard for many years, Eric decided to climb Mt. Qomolangma. Mountain climbing experts were very amazed when they heard this. The mountain called Qomolangma is very difficult to climb. Many people tried to climb it, but failed. The experts said he couldn't do it, but Eric wasn't worried.",
          "block_bbox": [
            225,
            1993,
            1947,
            2238
          ],
          "block_id": 20,
          "block_order": 8,
          "group_id": 20,
          "block_polygon_points": [
