              883.0,
              1491.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "品牌形象定位有记忆点，为突出中式茶饮形象，在外观设计上融入了漫画风的国宝大熊猫的元素，提高了品牌辨识度、更能抓住眼球。",
          "block_bbox": [
            882,
            1545,
            1578,
            1771
          ],
          "block_id": 6,
          "block_order": 6,
          "group_id": 6,
          "block_polygon_points": [
            [
              882.0,
              1545.0
            ],
            [
              1578.0,
              1545.0
            ],
            [
              1578.0,
              1771.0
            ],
            [
              882.0,
              1771.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "价格定位补充了市场空缺，在高端和低端市场分别已有喜茶、蜜雪冰城等品牌的情况下，将产品定价在新式茶饮的腰部，单价基本在16元-25元之间，以差异化价格获取客户。",
          "block_bbox": [
            881,
            1829,
            1586,
            2109
          ],
          "block_id": 7,
          "block_order": 7,
          "group_id": 7,
          "block_polygon_points": [
            [
              881.0,
