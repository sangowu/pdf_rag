        },
        {
          "block_label": "paragraph_title",
          "block_content": "适用于银行的全球原则",
          "block_bbox": [
            889,
            2155,
            1346,
            2213
          ],
          "block_id": 6,
          "block_order": 4,
          "group_id": 6,
