        {
          "block_label": "text",
          "block_content": "运营韧性被视为是运营风险有效管理的结果。",
          "block_bbox": [
            1640,
            1733,
            2315,
            1854
          ],
          "block_id": 11,
          "block_order": 9,
          "group_id": 11,
          "block_polygon_points": [
            [
              1640.0,
