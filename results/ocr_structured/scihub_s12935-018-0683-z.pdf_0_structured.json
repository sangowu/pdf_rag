        {
          "block_label": "paragraph_title",
          "block_content": "Abstract",
          "block_bbox": [
            252,
            1053,
            437,
            1106
          ],
          "block_id": 7,
          "block_order": 6,
          "group_id": 7,
          "block_polygon_points": [
            [
