              2172.0,
              10355.0
            ],
            [
              452.0,
              10355.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "Arsenal's early flow had been stifled. Joelinton's clear remit of sticking like glue to Arsenal captain Martin Odegaard was integral to Newcastle finding their feet.",
          "block_bbox": [
            453,
            10886,
            2174,
            11496
