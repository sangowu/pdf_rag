              5742.0
            ],
            [
              452.0,
              5742.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "That's not to say this was a one-man show. Far from it.",
          "block_bbox": [
            458,
            5743,
            2700,
            5940
          ],
          "block_id": 9,
          "block_order": 5,
          "group_id": 9,
