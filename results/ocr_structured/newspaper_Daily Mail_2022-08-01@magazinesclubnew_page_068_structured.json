              2700.0,
              5940.0
            ],
            [
              458.0,
              5940.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "This was a Newcastle away performance bursting with ability, discipline, work ethic and pride. Isak’s showing was merely the icing on the cake.",
