            234,
            1180,
            1110,
            1246
          ],
          "block_id": 8,
          "block_order": 8
        },
        {
          "block_label": "text",
          "block_content": "8.世界最大的盆地——刚果盆地",
          "block_bbox": [
            242,
            1277,
            1067,
            1336
          ],
          "block_id": 9,
          "block_order": 9
        },
        {
          "block_label": "text",
          "block_content": "9.世界人口最多的国家—中国",
          "block_bbox": [
            245,
            1370,
            987,
            1436
          ],
          "block_id": 10,
          "block_order": 10
        },
        {
          "block_label": "text",
          "block_content": "10.世界使用人数最多的国家—汉语",
          "block_bbox": [
            248,
            1459,
            1138,
            1528
          ],
          "block_id": 11,
          "block_order": 11
        },
        {
          "block_label": "text",
          "block_content": "11.世界便用最为广泛的语言—英语",
