        },
        {
          "block_label": "text",
          "block_content": "1.世界最大的大陆——亚欧大陆",
          "block_bbox": [
            237,
            615,
            1039,
            674
          ],
          "block_id": 2,
          "block_order": 2
        },
        {
          "block_label": "text",
          "block_content": "2.世界最大的州——亚洲",
          "block_bbox": [
            229,
            710,
            893,
            773
          ],
          "block_id": 3,
          "block_order": 3
        },
        {
          "block_label": "text",
          "block_content": "3.世界最小的州—大洋洲",
          "block_bbox": [
            232,
            804,
            923,
            862
          ],
          "block_id": 4,
          "block_order": 4
        },
        {
          "block_label": "text",
          "block_content": "4.世界最大的洋—太平洋",
          "block_bbox": [
            230,
            896,
            922,
            959
          ],
          "block_id": 5,
          "block_order": 5
        },
        {
          "block_label": "text",
          "block_content": "5.世界最小的洋——北冰洋",
          "block_bbox": [
            233,
            993,
            954,
            1056
          ],
          "block_id": 6,
          "block_order": 6
        },
        {
          "block_label": "text",
          "block_content": "6.世界最大的平原——亚马孙平原",
          "block_bbox": [
            234,
            1087,
            1062,
            1149
          ],
          "block_id": 7,
          "block_order": 7
        },
        {
          "block_label": "text",
          "block_content": "7.世界最长的山脉—安第斯山脉",
