        {
          "block_label": "paragraph_title",
          "block_content": "Abstract",
          "block_bbox": [
            204,
            1659,
            426,
            1713
          ],
          "block_id": 14,
          "block_order": 14,
          "group_id": 14,
          "block_polygon_points": [
