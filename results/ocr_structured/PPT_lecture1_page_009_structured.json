          "block_content": "\\begin{array}{r l r l r l}{x_{1}}&{-2x_{2}}&{+x_{3}}&{=0}\\\\ &{2x_{2}}&{-8x_{3}}&{=8}\\\\ &{-3x_{2}}&{+13x_{3}}&{=-9}\\end{array}\\quad\\begin{array}{r l r l}{\\left[\\begin{matrix}{1}&{-2}&{1}&{0}\\\\ {0}&{2}&{-8}&{8}\\\\ {0}&{-3}&{13}&{-9}\\end{matrix}\\right]}\\end{array}",
