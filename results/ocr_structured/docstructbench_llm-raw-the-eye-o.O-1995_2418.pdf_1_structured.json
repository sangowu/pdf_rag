        {
          "block_label": "text",
          "block_content": "Rule 291 requires, unless otherwise agreed, securities loaned to be delivered on the fifth business day following the day of the loan. “Fifth” will be changed to “third.” Rule 294 will be amended to change the return date for securities loaned from the fifth full business day following the date the notice is given to the third full business day.",
          "block_bbox": [
            84,
            158,
            424,
            337
          ],
          "block_id": 3,
