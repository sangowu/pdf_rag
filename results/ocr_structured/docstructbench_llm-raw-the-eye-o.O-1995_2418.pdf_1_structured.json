        {
          "block_label": "text",
          "block_content": "The proposed rule change is consistent with Section 6(b)(5) of the Act in that it protects investors and the public interest by reducing the risk to clearing corporations, their members, and public investors which is inherent in settling securities transactions. This is accomplished by reducing the time period for settlement of most securities transactions which will correspondingly decrease the number of unsettled trades in the clearance and settlement system at any given time.",
          "block_bbox": [
            438,
            1001,
            781,
            1262
          ],
          "block_id": 11,
          "block_order": 9,
          "group_id": 11,
          "block_polygon_points": [
            [
              438.0,
              1001.0
            ],
            [
              781.0,
              1001.0
            ],
            [
              781.0,
