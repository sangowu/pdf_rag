        {
          "block_label": "figure_title",
          "block_content": "Figure 1.4.1.1: DoD Risk Model. (\"DoD Risk Model\" by Unknown, U.S. Naval Academy - Cyber Science Dept is in the Public Domain, CC0)",
          "block_bbox": [
            312,
