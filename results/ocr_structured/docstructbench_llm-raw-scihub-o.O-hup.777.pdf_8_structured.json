        },
        {
          "block_label": "text",
          "block_content": "The number of errors on the processing speed task yielded a significant group effect,  $ F(2,122)=3.83 $, p<0.05. The ecstasy/cannabis group made more errors compared to the ‘ecstasy-only’ group and compared to non-users (Table 3). Of the pairwise comparisons, only the non-user versus ecstasy/cannabis user difference was significant, p<0.05. None of the interactions containing user group were statistically significant, F<1.65 in all cases.",
          "block_bbox": [
            134,
            560,
            576,
            717
          ],
          "block_id": 4,
          "block_order": 3,
          "group_id": 4,
          "block_polygon_points": [
