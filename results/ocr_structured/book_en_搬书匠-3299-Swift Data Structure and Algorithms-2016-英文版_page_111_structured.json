    "core_content": {
      "parsing_res_list": [
        {
          "block_label": "header",
          "block_content": "Standing on the Shoulders of Giants ",
          "block_bbox": [
            307,
            249,
            1041,
            299
          ],
          "block_id": 0,
          "block_order": null
        },
        {
          "block_label": "image",
          "block_content": "",
          "block_bbox": [
            387,
            405,
            616,
            638
          ],
          "block_id": 1,
          "block_order": null
        },
        {
          "block_label": "text",
          "block_content": "The sink and swim methods were inspired by the book Algorithms by Sedgewick and Wayne, Fourth Edition, Section 2.4.",
          "block_bbox": [
            661,
            397,
            2480,
            529
          ],
          "block_id": 2,
          "block_order": 1
        },
        {
          "block_label": "text",
          "block_content": "The structure accepts any type that conforms to the Comparable protocol. The single initializer allows you to optionally specify the sorting order and a list of starting values. The default sorting order is descending and the default starting values are an empty collection:",
          "block_bbox": [
            298,
            729,
            2682,
            936
          ],
          "block_id": 3,
          "block_order": 2
        },
        {
          "block_label": "text",
          "block_content": "/// Initialization \n\nvar priorityQueue = PriorityQueue<String>(ascending: true)\n/// Initializing with starting values \npriorityQueue = PriorityQueue<String>(ascending: true, startingValues:\n[\"Coldplay\", \"OneRepublic\", \"Maroon 5\", \"Imagine Dragons\", \"The Script\"])\nvar x = priorityQueue.pop()\n\n/// Coldplay \n\nX = priorityQueue.pop( )\n\n/// Imagine Dragons \n\n",
          "block_bbox": [
            398,
            988,
            2605,
            1712
          ],
          "block_id": 4,
          "block_order": 3
        },
        {
          "block_label": "paragraph_title",
          "block_content": "Protocols ",
          "block_bbox": [
            302,
            1860,
            771,
            1937
          ],
          "block_id": 5,
          "block_order": 4
        },
        {
          "block_label": "text",
          "block_content": "The PriorityQueue conforms to sequence, collection, and IteratorProtocol, so you can treat it like any other Swift sequence and collection:",
          "block_bbox": [
            298,
            1988,
            2683,
            2120
          ],
          "block_id": 6,
          "block_order": 5
        },
        {
          "block_label": "text",
          "block_content": "extension PriorityQueue: IteratorProtocol {\n\npublic typealias Element = T \nmutating public func next() -> Element? { return pop() }\n}\n\nextension PriorityQueue: Sequence {\n\npublic typealias Iterator = PriorityQueue \npublic func makeIterator() -> Iterator { return self }\n}\n\n",
          "block_bbox": [
            400,
            2177,
            2203,
            2708
          ],
          "block_id": 7,
          "block_order": 6
        },
        {
          "block_label": "text",
          "block_content": "This allows you to use Swift standard library functions on a PriorityQueue and iterate through a PriorityQueue like this:",
          "block_bbox": [
            300,
            2770,
            2589,
            2904
          ],
          "block_id": 8,
          "block_order": 7
        },
        {
          "block_label": "text",
          "block_content": "for x in priorityQueue {\nprint(x)\n\n}\n\n// Coldplay \n\n",
          "block_bbox": [
            401,
            2962,
            1137,
            3263
          ],
          "block_id": 9,
          "block_order": 8
        },
        {
          "block_label": "number",
          "block_content": "[97]",
          "block_bbox": [
            1436,
            3372,
            1562,
            3421
          ],
          "block_id": 10,
          "block_order": null
        }
      ],
      "markdown": "<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_387_405_616_638.jpg\" alt=\"Image\" width=\"7%\" /></div>\n\n\nThe sink and swim methods were inspired by the book Algorithms by Sedgewick and Wayne, Fourth Edition, Section 2.4.\n\nThe structure accepts any type that conforms to the Comparable protocol. The single initializer allows you to optionally specify the sorting order and a list of starting values. The default sorting order is descending and the default starting values are an empty collection:\n\n/// Initialization \n\nvar priorityQueue = PriorityQueue<String>(ascending: true)\n\n/// Initializing with starting values \n\npriorityQueue = PriorityQueue<String>(ascending: true, startingValues:\n\n[\"Coldplay\", \"OneRepublic\", \"Maroon 5\", \"Imagine Dragons\", \"The Script\"])\n\nvar x = priorityQueue.pop()\n\n/// Coldplay \n\nX = priorityQueue.pop( )\n\n/// Imagine Dragons \n\n\n\n## Protocols \n\nThe PriorityQueue conforms to sequence, collection, and IteratorProtocol, so you can treat it like any other Swift sequence and collection:\n\nextension PriorityQueue: IteratorProtocol {\n\npublic typealias Element = T \n\nmutating public func next() -> Element? { return pop() }\n\n}\n\nextension PriorityQueue: Sequence {\n\npublic typealias Iterator = PriorityQueue \n\npublic func makeIterator() -> Iterator { return self }\n\n}\n\n\n\nThis allows you to use Swift standard library functions on a PriorityQueue and iterate through a PriorityQueue like this:\n\nfor x in priorityQueue {\n\nprint(x)\n\n}\n\n// Coldplay \n\n",
      "tables": [],
      "formulas": [],
      "seals": []
    },
