        {
          "block_label": "paragraph_title",
          "block_content": "Help us build institutional capacity and develop the finance sector across Latin America and the Caribbean.\nSector Manager, Institutions for Development, Washington DC",
          "block_bbox": [
            799,
            1204,
            1369,
