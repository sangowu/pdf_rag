[
  {
    "filename": "yanbaor2_ey-beyond-traditional-corporate-governance.pdf_1.pdf",
    "page_index": 1,
    "core_content": {
      "parsing_res_list": [
        {
          "block_label": "image",
          "block_content": "Beyond \n\ntraditional \n\ncorporate \n\ngovernance:\nWhat's the role \n\nof the board \n\nin fostering \n\nsustainability and \n\ninnovation?\n\n",
          "block_bbox": [
            124,
            8,
            2479,
            1660
          ],
          "block_id": 0,
          "block_order": null
        },
        {
          "block_label": "text",
          "block_content": "TheEuropeanCorporateGovernanceConference2021explored how boards can support the process of longterm value creation.\n",
          "block_bbox": [
            134,
            2056,
            1178,
            2214
          ],
          "block_id": 1,
          "block_order": 1
        },
        {
          "block_label": "text",
          "block_content": "Boards shouldmaketimetoreflectontheir company's long-term value creation and itsrole in the global value chain.\n",
          "block_bbox": [
            137,
            2238,
            1144,
            2395
          ],
          "block_id": 2,
          "block_order": 2
        },
        {
          "block_label": "text",
          "block_content": "Auditcommittees canassure thereliabilityofthe information usedto informdecision-making,making links between financial and sustainabilityrisks.",
          "block_bbox": [
            137,
            2418,
            1183,
            2571
          ],
          "block_id": 3,
          "block_order": 3
        },
        {
          "block_label": "text",
          "block_content": "Sustainable corporategovernance willhelp to drive better risk management,greater innovation and higher levels of transparency.\n",
          "block_bbox": [
            137,
            2593,
            1168,
            2750
          ],
          "block_id": 4,
          "block_order": 4
        },
        {
          "block_label": "paragraph_title",
