    "core_content": {
      "parsing_res_list": [
        {
          "block_label": "paragraph_title",
          "block_content": "Day2Research Items Needed for YourTrip ",
          "block_bbox": [
            325,
            520,
            1545,
            580
          ],
          "block_id": 0,
          "block_order": 1
        },
        {
          "block_label": "text",
          "block_content": "Estimate how long thetrip will take if you travel60miles perhour.Determine how many stops for gas you will need to make if your car can travel 30 miles per gallon and holds18 gallons of gas.",
          "block_bbox": [
            325,
            605,
            1906,
            791
          ],
          "block_id": 1,
          "block_order": 2
        },
        {
          "block_label": "text",
          "block_content": "Write an equation to determine how much you will spend on gas for the entire trip if gas costs $2.50 per gallon.\n",
          "block_bbox": [
            327,
            806,
            1905,
            924
          ],
          "block_id": 2,
          "block_order": 3
        },
        {
          "block_label": "text",
          "block_content": "Placethecostofthe gas inthetablefrom Day1.",
          "block_bbox": [
            328,
            939,
            1459,
            990
          ],
          "block_id": 3,
          "block_order": 4
        },
        {
          "block_label": "paragraph_title",
          "block_content": "Day 3What ToDoWhenYouGetThere ",
          "block_bbox": [
            327,
            1099,
            1437,
            1155
          ],
          "block_id": 4,
          "block_order": 5
        },
        {
          "block_label": "text",
          "block_content": "Research what you would like to do when you reach your final destination.\n",
          "block_bbox": [
            328,
            1184,
            1773,
            1297
          ],
          "block_id": 5,
          "block_order": 6
        },
        {
          "block_label": "text",
          "block_content": "Design a calendar forthe week.Account for howeachhour is spent.",
          "block_bbox": [
            327,
            1318,
            1895,
            1369
          ],
          "block_id": 6,
          "block_order": 7
        },
        {
          "block_label": "text",
          "block_content": "Drawa clock next to each event to showthe time it willoccur.Write the elapsed time for each event.\n",
          "block_bbox": [
            328,
            1386,
            1898,
            1500
          ],
          "block_id": 7,
          "block_order": 8
        },
        {
          "block_label": "text",
          "block_content": "Research prices on the places you will visit and the food you will eat.Add these figures to the table that was createdon Day1.",
          "block_bbox": [
            328,
            1519,
            1906,
            1636
          ],
          "block_id": 8,
          "block_order": 9
        },
        {
          "block_label": "paragraph_title",
          "block_content": "Day 4 What Is the Cost?",
          "block_bbox": [
            328,
            1745,
            1011,
            1801
          ],
          "block_id": 9,
          "block_order": 10
        },
        {
          "block_label": "text",
          "block_content": "•Research prices forthe hotel.Placethis on thetable from Day1.",
          "block_bbox": [
            326,
            1830,
            1810,
            1881
          ],
          "block_id": 10,
          "block_order": 11
        },
        {
          "block_label": "text",
          "block_content": "Calculate the total costofthetrip using the table from Day1.",
          "block_bbox": [
            327,
            1898,
            1738,
            1947
          ],
          "block_id": 11,
          "block_order": 12
        },
        {
          "block_label": "image",
          "block_content": "",
          "block_bbox": [
            1970,
            1023,
            2457,
            1683
          ],
          "block_id": 12,
          "block_order": null
        },
        {
          "block_label": "text",
          "block_content": "Prepare a posterto present to the class that shows the information about your trip.\n",
          "block_bbox": [
            328,
            1966,
            1867,
            2083
          ],
          "block_id": 13,
          "block_order": 13
        },
        {
          "block_label": "paragraph_title",
          "block_content": "Day 5Presentation Day ",
          "block_bbox": [
            328,
            2191,
            1007,
            2248
          ],
          "block_id": 14,
          "block_order": 14
        },
        {
          "block_label": "text",
          "block_content": "Present your trip to the class.",
          "block_bbox": [
            329,
            2277,
            1025,
            2327
          ],
          "block_id": 15,
          "block_order": 15
        },
        {
          "block_label": "text",
          "block_content": "Include a summary of where you would go,your calendar,the total cost, and the poster you creatd.\n",
          "block_bbox": [
            327,
