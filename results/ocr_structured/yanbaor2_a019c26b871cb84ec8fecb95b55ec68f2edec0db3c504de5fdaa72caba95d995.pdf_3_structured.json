              398.0,
              1421.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "第二，欧盟、美国和中国等大型重要市场有可能会通过相互冲突的人工智能监管法规，企业无法——遵循。",
          "block_bbox": [
            400,
            1450,
            2141,
            1507
          ],
          "block_id": 7,
          "block_order": 7,
          "group_id": 7,
          "block_polygon_points": [
            [
              400.0,
              1450.0
            ],
            [
              2141.0,
              1450.0
            ],
