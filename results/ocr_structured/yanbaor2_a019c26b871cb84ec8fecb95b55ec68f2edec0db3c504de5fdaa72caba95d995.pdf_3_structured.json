              400.0,
              1277.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "首先，利益相关方受通过实施的监管法规影响，可能会在部分辖区关闭由人工智能驱动的功能，或完全停止在部分辖区的运营——或继续正常运营，受到处罚，然后支付相关罚款作为业务运营的成本。",
          "block_bbox": [
            398,
            1307,
            2120,
            1421
          ],
          "block_id": 6,
          "block_order": 6,
          "group_id": 6,
          "block_polygon_points": [
            [
              398.0,
              1307.0
            ],
            [
              2120.0,
              1307.0
            ],
            [
              2120.0,
