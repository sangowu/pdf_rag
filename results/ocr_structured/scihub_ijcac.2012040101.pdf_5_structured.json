        {
          "block_label": "paragraph_title",
          "block_content": "Validation Tests",
          "block_bbox": [
            289,
            1353,
            651,
            1406
          ],
          "block_id": 6,
          "block_order": 3,
          "group_id": 6,
          "block_polygon_points": [
