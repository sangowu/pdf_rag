        {
          "block_label": "doc_title",
          "block_content": "What should you consider when selecting a NB to issue your NBOp?",
          "block_bbox": [
            400,
            181,
            2168,
            584
          ],
          "block_id": 1,
          "block_order": 1,
          "group_id": 1,
          "block_polygon_points": [
            [
