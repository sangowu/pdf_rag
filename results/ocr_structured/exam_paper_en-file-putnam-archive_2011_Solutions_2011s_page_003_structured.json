              1000.0
            ]
          ]
        },
        {
          "block_label": "display_formula",
          "block_content": " $$ \\frac{f(x)-f(0)}{x}=(h_{1}(x)+h_{2}(x)h_{3}(x))h_{4}(x), $$ ",
