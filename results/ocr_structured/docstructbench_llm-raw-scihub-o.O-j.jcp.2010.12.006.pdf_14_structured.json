              71.0,
              1124.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "For example,  $ \\varphi $ for the boxscheme is given by",
          "block_bbox": [
            93,
            1124,
            451,
            1144
          ],
          "block_id": 14,
          "block_order": 4,
          "group_id": 14,
          "block_polygon_points": [
            [
              93.0,
              1124.0
            ],
            [
              450.0,
              1124.0
            ],
            [
              450.0,
              1143.0
            ],
            [
              93.0,
              1143.0
            ]
          ]
        },
        {
          "block_label": "display_formula",
          "block_content": " $$ \\varphi=\\tan^{-1}\\left(\\frac{\\sin\\left(\\frac{1}{2}\\sin(\\theta)a\\right)\\cos^{3}\\left(\\frac{1}{2}\\cos(\\theta)a\\right)}{\\cos^{3}\\left(\\frac{1}{2}\\sin(\\theta)a\\right)\\sin\\left(\\frac{1}{2}\\cos(\\theta)a\\right)}\\right). $$ ",
          "block_bbox": [
            117,
