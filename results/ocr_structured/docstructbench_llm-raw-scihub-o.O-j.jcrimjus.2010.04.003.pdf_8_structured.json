        {
          "block_label": "paragraph_title",
          "block_content": "Notes",
          "block_bbox": [
            63,
            220,
            114,
            239
          ],
          "block_id": 3,
          "block_order": 2,
          "group_id": 3,
          "block_polygon_points": [
