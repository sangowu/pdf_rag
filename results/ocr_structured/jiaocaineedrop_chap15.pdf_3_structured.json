    "core_content": {
      "parsing_res_list": [
        {
          "block_label": "text",
          "block_content": "Instead,theconsumerprotectionlawsand other laws of her state regulate her business.",
          "block_bbox": [
            327,
            247,
            1188,
            350
          ],
          "block_id": 0,
          "block_order": 1
        },
        {
          "block_label": "text",
          "block_content": "The Federal TradeCommission(FTC)is the agencyoftheU.S.government that promotes free andfairtradecompetition.TheBureauof ConsumerProtection safeguardsconsumers againstunfair,deceptive,orfraudulentpractices.Bothorganizations investigate violations of federal consumer protection law.",
          "block_bbox": [
            250,
            420,
            1189,
            817
          ],
          "block_id": 1,
          "block_order": 2
        },
        {
          "block_label": "paragraph_title",
          "block_content": "Unfair andDeceptive Practices \n",
          "block_bbox": [
            253,
            875,
            1070,
            1014
          ],
          "block_id": 2,
          "block_order": 3
        },
        {
          "block_label": "text",
          "block_content": "An unfair and deceptive practice is an actthatmisleadsconsumers.Moststates have enactedeithertheUniform DeceptiveTrade ",
          "block_bbox": [
            251,
