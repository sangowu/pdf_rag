            [
              913.0,
              1481.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "The Commission invites comments on whether the Postal Service’s filings in the captioned dockets are consistent with the policies of 39 U.S.C. 3632, 3633, or 3642, 39 CFR part 3015, and 39 CFR part 3020, subpart B. Comments are due no later than July 14, 2015. The public portions of these filings can be accessed via the Commission’s Web site (http://www.prc.gov).",
          "block_bbox": [
