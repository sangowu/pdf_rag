          "block_id": 1,
          "block_order": 1
        },
        {
          "block_label": "text",
          "block_content": "107. gather ,collect \n\ngather把分散的东西集中到一起，ouect指精心地、有选择地进行收集.\ncollect stamps.\n\n",
          "block_bbox": [
