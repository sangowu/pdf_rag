          ],
          "block_id": 6,
          "block_order": 6
        },
        {
          "block_label": "text",
          "block_content": "112.arrive, get, reach \narrive 不及物动词，后接in(大地点)，at(小地点)；get不及物动词后如reaeit 113. grow,plant \n",
          "block_bbox": [
            192,
