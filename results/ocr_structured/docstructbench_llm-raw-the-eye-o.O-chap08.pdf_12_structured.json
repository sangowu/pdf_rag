            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "- Using the function GetNewDialog, which takes descriptive information about the dialog from dialog ('DLOG') and extended dialog ('d1gx') resources. The resource ID of the 'DLOG' and 'd1gx' resources must be the same, and is passed in the first parameter of this function.",
          "block_bbox": [
            140,
            456,
            1031,
            524
          ],
          "block_id": 3,
          "block_order": 3,
          "group_id": 3,
          "block_polygon_points": [
