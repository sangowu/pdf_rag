        {
          "block_label": "text",
          "block_content": "The dialog structure created by the GetNewDialog call is defined by the data type DialogRecord:",
          "block_bbox": [
            140,
            1069,
            958,
            1093
          ],
          "block_id": 10,
          "block_order": 10,
          "group_id": 10,
