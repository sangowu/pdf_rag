          ]
        },
        {
          "block_label": "algorithm",
          "block_content": "struct DialogRecord\n{\n    WindowRecord window; // Dialog's window record.\n    Handle items; // Item list resource.\n    TEHandle text; // Current editable text item.\n    SInt16 editField; // Editable text item number minus 1.\n    SInt16 editOpen; // (Used internally.)\n    SInt16 aDefItem; // Default push button item number.\n};\ntypedef struct DialogRecord DialogRecord;\ntypedef DialogRecord *DialogPeek;",
          "block_bbox": [
            169,
            1110,
            798,
            1306
          ],
          "block_id": 11,
          "block_order": 11,
          "group_id": 11,
          "block_polygon_points": [
