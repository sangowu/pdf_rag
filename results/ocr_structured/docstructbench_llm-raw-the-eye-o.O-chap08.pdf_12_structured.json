            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "The extended dialog resource and the NewFeaturesDialog function were introduced with OS 8 and the Appearance Manager. NewFeaturesDialog should be used to create Appearance-compliant dialogs. Unlike NewDialog and NewColorDialog, it has a flags parameter containing the same flags you would set in an extended dialog resource.",
          "block_bbox": [
            201,
            662,
            960,
            745
          ],
          "block_id": 6,
          "block_order": 6,
          "group_id": 6,
          "block_polygon_points": [
            [
              201.0,
              662.0
            ],
            [
              960.0,
              662.0
