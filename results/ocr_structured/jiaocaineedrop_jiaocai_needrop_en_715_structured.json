          ],
          "block_id": 9,
          "block_order": 7
        },
        {
          "block_label": "text",
          "block_content": "Peter: Hi,Amy! What's the weather like in Shanghai today?",
          "block_bbox": [
            252,
            1272,
            1322,
            1313
          ],
          "block_id": 10,
          "block_order": 8
        },
        {
          "block_label": "text",
          "block_content": "Amy: Hello,Peter! It's sunny and warm here. I'm going to the zoo this afternoon.",
          "block_bbox": [
            253,
            1353,
            1707,
            1394
          ],
          "block_id": 11,
          "block_order": 9
        },
        {
          "block_label": "text",
          "block_content": "Peter: That's cool!",
          "block_bbox": [
            254,
            1435,
            596,
            1471
          ],
          "block_id": 12,
          "block_order": 10
        },
        {
          "block_label": "text",
          "block_content": "Amy: Peter,how is the weather in Beijing now?",
          "block_bbox": [
            254,
            1518,
            1083,
            1557
          ],
          "block_id": 13,
          "block_order": 11
        },
        {
          "block_label": "text",
          "block_content": "Peter: It's cloudy. It's going to rain. So I can't fly a kite in the park.",
          "block_bbox": [
            253,
            1598,
            1504,
            1638
          ],
          "block_id": 14,
          "block_order": 12
        },
        {
          "block_label": "text",
          "block_content": "Amy: Oh,I see.",
          "block_bbox": [
            255,
            1681,
            533,
            1719
          ],
          "block_id": 15,
          "block_order": 13
        },
        {
          "block_label": "text",
          "block_content": "Peter: Do you know the weather in Guangzhou?",
          "block_bbox": [
            254,
            1761,
            1090,
            1800
          ],
          "block_id": 16,
          "block_order": 14
        },
        {
          "block_label": "text",
          "block_content": "Amy:It's very hot there.The children there usually go swimming in the sea.It's going to rain this afternoon.\n",
          "block_bbox": [
            254,
            1843,
            1810,
            1962
          ],
          "block_id": 17,
          "block_order": 15
        },
        {
          "block_label": "text",
          "block_content": "Peter: Oh,I like swimming too. But I can't swim now. It's a little cold.",
          "block_bbox": [
            252,
            2004,
            1506,
            2044
          ],
          "block_id": 18,
          "block_order": 16
        },
        {
          "block_label": "text",
          "block_content": ")1.It's fine in Shanghai.",
          "block_bbox": [
            252,
            2086,
            799,
            2128
          ],
          "block_id": 19,
          "block_order": 17
        },
        {
          "block_label": "text",
          "block_content": "( )2.Peter is in Guangzhou.",
          "block_bbox": [
            253,
            2167,
            812,
            2209
          ],
          "block_id": 20,
          "block_order": 18
        },
        {
          "block_label": "text",
          "block_content": "(   )3.It's cloudy in Beijing.",
          "block_bbox": [
            253,
            2248,
            805,
            2292
          ],
          "block_id": 21,
          "block_order": 19
        },
        {
          "block_label": "text",
          "block_content": ")4.It's cool in Guangzhou.",
          "block_bbox": [
            254,
            2330,
            828,
            2372
          ],
          "block_id": 22,
          "block_order": 20
        },
        {
          "block_label": "text",
          "block_content": "( )5.Amy is going to swim.",
