            [
              1571.0,
              2537.0
            ],
            [
              246.0,
              2537.0
            ]
          ]
        },
        {
          "block_label": "text",
          "block_content": "正雅齿科始终坚持经由自主研发打造技术优势，在嘉兴科技城和中国“牙谷”资阳分别建有研发基地和智能生产基地，目前全球员工已逾两千人，其中包括就职于正雅中国隐形矫治临床医学部门、由专业正畸博士领衔数百人医学团队。2022年，正雅完成5亿元D轮融资，并将持续深耕推动数字化正畸产业布局。",
          "block_bbox": [
            246,
            2595,
            1572,
            2821
          ],
          "block_id": 18,
          "block_order": 15,
          "group_id": 18,
