        {
          "block_label": "text",
          "block_content": "作为口腔医疗机械研发和生产领域具有创新性和成长性的高新技术企业之一，正雅齿科将3D打印技术与临床医学、材料科学、生物力学、大数据等技术结合，专注探索数字化隐形正畸技术的无限可能，持续创新有中国特色的隐形正畸技术，致力于将前沿的隐形正畸科技带给用户。",
          "block_bbox": [
            246,
            2311,
            1571,
            2537
          ],
          "block_id": 17,
          "block_order": 14,
          "group_id": 17,
          "block_polygon_points": [
            [
              246.0,
