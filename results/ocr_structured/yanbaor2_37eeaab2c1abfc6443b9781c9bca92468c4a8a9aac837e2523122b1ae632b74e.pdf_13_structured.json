        {
          "block_label": "paragraph_title",
          "block_content": "1.2. 中国领先的生物制药和生物科技公司吸引了全球金融投资者",
          "block_bbox": [
            134,
            534,
            820,
            642
          ],
          "block_id": 1,
          "block_order": 1,
          "group_id": 1,
          "block_polygon_points": [
