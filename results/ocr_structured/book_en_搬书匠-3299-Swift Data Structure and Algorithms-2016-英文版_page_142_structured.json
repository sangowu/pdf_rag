        },
        {
          "block_label": "text",
          "block_content": "Now let's review these concepts with the following tree example:",
          "block_bbox": [
            226,
            298,
            1492,
            346
          ],
          "block_id": 1,
          "block_order": 1
        },
        {
          "block_label": "image",
          "block_content": "Root \n2\nEdge \n\n81Node \n7115Leaves \n",
          "block_bbox": [
            702,
