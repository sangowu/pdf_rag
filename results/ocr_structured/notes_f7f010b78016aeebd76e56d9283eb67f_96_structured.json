          ],
          "block_id": 7,
          "block_order": 7
        },
        {
          "block_label": "text",
          "block_content": "There is a place on our earth where hot water and steam come up under the ground. It is on a large island in the Pacific Ocean. The island is North Island in New Zalnd.",
          "block_bbox": [
            212,
            1583,
            1986,
            1849
          ],
          "block_id": 8,
          "block_order": 8
        },
        {
          "block_label": "text",
          "block_content": "D.蒸汽",
