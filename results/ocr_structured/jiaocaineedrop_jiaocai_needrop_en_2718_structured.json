        },
        {
          "block_label": "text",
          "block_content": "取$t=0$ 时刻的波源的平衡位置为坐标原点，",
          "block_bbox": [
            230,
            300,
            1171,
            350
          ],
          "block_id": 1,
          "block_order": 2
        },
        {
          "block_label": "text",
          "block_content": "则其波的图像如图$3-2-5$ 所示.",
          "block_bbox": [
            230,
            379,
