        {
          "block_label": "text",
          "block_content": "宏观经济环境对办公资产的影响仍在持续，全球空置率达到两位数。利率上调抬高了收购和建设的债务成本，并对潜在回报率造成下行压力。随着建筑物等级成为获得资本和提升资产财务表现越来越重要的决定因素，短期内融资将面临更大挑战。",
          "block_bbox": [
            144,
            550,
            1466,
            786
          ],
          "block_id": 2,
          "block_order": 3,
          "group_id": 2,
          "block_polygon_points": [
