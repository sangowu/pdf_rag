        {
          "block_label": "text",
          "block_content": "KEYWORDS\ngene therapy, modifier\ngene, polymorphism,\nprimary ciliary\ndyskinesia, sickle cell,\nimmunodeficiencies,\nstorage diseases, sickle\ncell, obstructive sleep\napnoea, fibrosis,\nauto-immune.",
