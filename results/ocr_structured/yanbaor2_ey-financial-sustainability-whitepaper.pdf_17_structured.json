      "parsing_res_list": [
        {
          "block_label": "paragraph_title",
          "block_content": "Strategies to manage rising costs",
          "block_bbox": [
            112,
            333,
            1263,
            425
          ],
          "block_id": 0,
          "block_order": 1,
          "group_id": 0,
          "block_polygon_points": [
            [
              112.0,
